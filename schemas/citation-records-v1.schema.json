{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nameorigin.io/schemas/citation-records-v1.schema.json",
  "title": "Citation Records v1",
  "description": "Entity-level citation records mapped to canonical Citation Registry IDs. Phase 8B.",
  "type": "object",
  "required": ["schemaVersion", "title", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "title": { "type": "string" },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "baselineReference": { "type": "string" },
    "methodology": { "type": "string" },
    "stats": {
      "type": "object",
      "additionalProperties": true
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["name", "citations"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin": { "$ref": "#/$defs/citationIdList" },
            "meaning": { "$ref": "#/$defs/citationIdList" },
            "pronunciation": { "$ref": "#/$defs/citationIdList" },
            "etymology": { "$ref": "#/$defs/citationIdList" },
            "history": { "$ref": "#/$defs/citationIdList" }
          }
        }
      }
    },
    "citationIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    }
  }
}
